            self.table.setColumnWidth(7, 120)
            self.table.setColumnWidth(8, 120)

        lay.addWidget(self.table)

        # ????????? ??? ?????? ??????? ? ???????? ???? ?? Ctrl+C
        self.table.setSelectionMode(QAbstractItemView.SelectionMode.ExtendedSelection)
        self.table.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectItems)

        def copy_selected_cells():
            selected = self.table.selectedItems()
            if not selected:
                return

            rows = {}
            for item in selected:
                rows.setdefault(item.row(), {})[item.column()] = item.text()

            output = []
            for row in sorted(rows):
                values = []
                for col in sorted(rows[row]):
                    values.append(rows[row][col])
                output.append("\t".join(values))

            QApplication.clipboard().setText("\n".join(output))

        self.table.keyPressEvent_original = self.table.keyPressEvent

        def table_key_press(event):
            if event.key() == Qt.Key.Key_C and event.modifiers() & Qt.KeyboardModifier.ControlModifier:
                copy_selected_cells()
                return
            self.table.keyPressEvent_original(event)

        self.table.keyPressEvent = table_key_press

