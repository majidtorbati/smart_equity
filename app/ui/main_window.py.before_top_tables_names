    def _load_font_families(self):
        """
        تمام خانواده فونت‌های نصب‌شده در Windows را
        داخل هر دو QFontComboBox قرار می‌دهد.
        """
        families = installed_font_families()

        if not families:
            return

        self.heading_font_combo.clear()
        self.body_font_combo.clear()

        self.heading_font_combo.addItems(
            families
        )
        self.body_font_combo.addItems(
            families
        )

    def _set_font_combo(
        self,
        combo: QFontComboBox,
        font_name: str
    ):
        """
        فونت ذخیره‌شده را در ComboBox انتخاب می‌کند.
        اگر فونت در فهرست موجود نباشد، متن آن را حفظ می‌کند
        تا تنظیمات قبلی بدون دلیل از بین نرود.
        """
        font_name = str(font_name or "").strip()

        if not font_name:
            return

        index = combo.findText(
            font_name,
            Qt.MatchFixedString
        )

        if index >= 0:
            combo.setCurrentIndex(index)
        else:
            combo.setCurrentText(font_name)

