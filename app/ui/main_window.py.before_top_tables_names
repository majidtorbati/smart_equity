        self.provider_label.setText("برای اجرای تحلیل، دکمه «اجرای تحلیل هوشمند» را بزنید.")

    def run_analysis(self):
        conn, start, end = self.get_conn_and_range()
        if conn is None:
            QMessageBox.warning(self, "داده موجود نیست", "ابتدا فایل رجیستری و فایل معاملات را Import کنید.")
