def fmt_num(x):
    try:
        return f"{x:,.0f}"
    except Exception:
        return str(x)


def fmt_delta_num(x):
    """برای جدول مقایسه: اعداد صحیح بزرگ (مثل ارزش/تعداد) بدون اعشار، مقادیر کسری (قیمت/HHI) با دو رقم اعشار."""
    if not isinstance(x, (int, float)):
        return x
    if float(x).is_integer():
        return f"{x:,.0f}"
    return f"{x:,.2f}"


def jalali_to_greg_str(jalali_str: str) -> str | None:
    """ورودی '1405/03/13' -> '2026-06-03'."""
    if not jalali_str or not jalali_str.strip():
        return None
    try:
        parts = jalali_str.strip().replace("-", "/").split("/")
        jy, jm, jd = int(parts[0]), int(parts[1]), int(parts[2])
        from app.core.jalali import jalali_to_gregorian
        return jalali_to_gregorian(jy, jm, jd).isoformat()
    except Exception:
        return None


