def apply_table_filter(table: QTableWidget, query: str, column: int | None = 0):
    """
    ردیف‌های جدول را بر اساس متن جستجو پنهان/نمایان می‌کند (بدون واکشی مجدد از دیتابیس).
    column=0 یعنی فقط ستون نام بررسی شود (چون در تمام جدول‌های این برنامه، ستون منطقی ۰ همیشه
    «نام»/«نام کارگزار» است — جهت راست‌به‌چپ فقط محل نمایش را برمی‌گرداند، نه اندیس منطقی ستون).
    column=None یعنی همه‌ی ستون‌های آن ردیف بررسی شوند (برای جدول‌هایی مثل هشدارها که نام ممکن
    است داخل متن توضیح ظاهر شود، نه در یک ستون ثابت).
    """
    query = query.strip().lower()
    for row in range(table.rowCount()):
        if not query:
            table.setRowHidden(row, False)
            continue
        if column is not None:
            item = table.item(row, column)
            matched = bool(item) and query in item.text().lower()
        else:
            matched = False
            for col in range(table.columnCount()):
                item = table.item(row, col)
                if item and query in item.text().lower():
                    matched = True
                    break
        table.setRowHidden(row, not matched)


