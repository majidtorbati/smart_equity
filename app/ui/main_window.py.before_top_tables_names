def make_table(headers: list[str]) -> QTableWidget:
    t = QTableWidget(0, len(headers))
    t.setHorizontalHeaderLabels(headers)
    t.horizontalHeader().setSectionResizeMode(QHeaderView.Interactive)
    t.horizontalHeader().setMinimumSectionSize(70)
    t.setLayoutDirection(Qt.RightToLeft)
    t.setEditTriggers(QAbstractItemView.NoEditTriggers)
    t.setSelectionBehavior(QAbstractItemView.SelectRows)
    t.setSortingEnabled(True)
    t.setAlternatingRowColors(True)
    return t


class NumericTableWidgetItem(QTableWidgetItem):
    """
    QTableWidgetItem معمولی وقتی DisplayRole عدد اعشاری بزرگ باشد، هنگام رسم (نه در .text())
    آن را با فرمت‌دهی QLocale به نماد علمی تبدیل می‌کند (مثلاً 6.06742e+10 به‌جای 60,674,204,694).
    این کلاس متن نمایشی را از قبل به‌صورت رشته‌ی تمیز می‌سازد و مرتب‌سازی عددی صحیح را
    با نگه‌داشتن مقدار خام برای مقایسه (نه بر اساس متن) تضمین می‌کند.
    """
    def __init__(self, raw_value):
        super().__init__(fmt_delta_num(raw_value))
        self._raw = raw_value

    def __lt__(self, other):
        if isinstance(other, NumericTableWidgetItem):
            try:
                return self._raw < other._raw
            except (TypeError, ValueError):
                return self.text() < other.text()

        return self.text() < other.text()


def fill_table(table: QTableWidget, rows: list[list], default_sort_col: int = None, descending: bool = True):
    table.setSortingEnabled(False)
    table.setRowCount(len(rows))
    for r, row in enumerate(rows):
        for c, val in enumerate(row):
            if isinstance(val, (int, float)):
                item = NumericTableWidgetItem(val)
            else:
                item = QTableWidgetItem(str(val))
            table.setItem(r, c, item)
    table.setSortingEnabled(True)
    # Qt.setSortingEnabled(True) silently applies its own default sort (usually column 0)
    # which would scramble an intentionally value-ordered result set. Force the intended sort.
    if default_sort_col is not None:
        order = Qt.DescendingOrder if descending else Qt.AscendingOrder
        table.sortByColumn(default_sort_col, order)
    else:
        # no natural rank column (e.g. a heterogeneous metrics table) -> keep insertion order,
        # column -1 clears Qt's sort indicator instead of silently re-sorting by column 0.
        table.sortByColumn(-1, Qt.AscendingOrder)


