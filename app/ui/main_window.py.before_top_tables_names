class _AIWorker(QRunnable):
    def __init__(self, db_path, start, end):
        super().__init__()
        self.db_path = db_path
        self.start = start
        self.end = end
        self.signals = _AIWorkerSignals()

    def run(self):
        conn = None
        try:
            conn = sqlite3.connect(str(self.db_path))
            result = generate_analysis(conn, self.start, self.end)
            self.signals.finished.emit(result)
        except Exception as exc:
            self.signals.failed.emit(str(exc))
        finally:
            if conn is not None:
                try:
                    conn.close()
                except Exception:
                    pass


class AIAssistantPage(QWidget):
    """دستیار هوشمند با مسیر خودکار Local -> Local OpenAI-compatible -> Internet -> Built-in."""
    def __init__(self, get_conn_and_range):
        super().__init__()
        self.get_conn_and_range = get_conn_and_range
        self.pool = QThreadPool.globalInstance()
        lay = QVBoxLayout(self)
