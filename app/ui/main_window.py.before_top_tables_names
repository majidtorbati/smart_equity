    def _delete_imported_data(self):
        """داده‌های واردشده را حذف می‌کند ولی Schema، تنظیمات و لوگو را حفظ می‌کند."""
        DB_PATH.parent.mkdir(parents=True, exist_ok=True)

        conn = sqlite3.connect(str(DB_PATH))

        # ابتدا جداول وابسته و محاسباتی، سپس جداول اصلی داده.
        tables = [
            "fifo_realizations",
            "fifo_lots",
            "identity_matches",
            "transactions",
            "data_quality",
            "alerts",
            "analysis_cache",
            "portfolio_analysis_cache",
            "persons",
            "brokers",
            "symbols",
            "import_batches",
            "registry_holdings",
            "registry_batches",
        ]

        try:
            for table in tables:
                conn.execute(f"DELETE FROM {table}")
            conn.commit()
        finally:
            conn.close()

    def closeEvent(self, event):
        """هنگام خروج، کاربر انتخاب می‌کند داده‌ها حفظ یا حذف شوند."""
        if not self.conn:
            event.accept()
            return

        box = QMessageBox(self)
        box.setWindowTitle("خروج از Smart Equity")
        box.setText("با داده‌های واردشده چه کاری انجام شود؟")
        box.setInformativeText(
            "تنظیمات برنامه و لوگو در هر دو حالت حفظ می‌شوند."
        )
        box.setIcon(QMessageBox.Question)

        btn_delete = box.addButton(
            "حذف داده‌ها و خروج",
            QMessageBox.DestructiveRole
        )
        btn_keep = box.addButton(
            "حفظ داده‌ها و خروج",
            QMessageBox.AcceptRole
        )
        btn_cancel = box.addButton(
            "انصراف",
            QMessageBox.RejectRole
        )

        box.exec()

        clicked = box.clickedButton()

        if clicked == btn_cancel:
            event.ignore()
            return

        try:
            self.conn.commit()
            self.conn.close()
            self.conn = None

            if clicked == btn_delete:
                self._delete_imported_data()

            event.accept()

        except Exception as e:
            QMessageBox.critical(
                self,
                "خطا هنگام خروج",
                f"عملیات خروج با خطا مواجه شد:\n{e}"
            )
            event.ignore()


