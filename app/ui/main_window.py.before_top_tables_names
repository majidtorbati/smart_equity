    def get_conn_and_range(self):
        start = jalali_to_greg_str(self.start_edit.text())
        end = jalali_to_greg_str(self.end_edit.text())
        return self.conn, start, end

    def on_preset_changed(self, idx):
        if not self.conn:
            return
        row = self.conn.execute("SELECT MAX(trade_date_gregorian) FROM transactions").fetchone()
        last_date_str = row[0] if row and row[0] else None
        if last_date_str is None:
            return
        last_date = dt.date.fromisoformat(last_date_str)
        label = self.preset_combo.currentText()
        if label == "کل بازه":
            self.start_edit.clear()
            self.end_edit.clear()
        elif label == "۷ روز اخیر":
            start = last_date - dt.timedelta(days=7)
            self.start_edit.setText(to_jalali_str(start))
            self.end_edit.setText(to_jalali_str(last_date))
        elif label == "۳۰ روز اخیر":
            start = last_date - dt.timedelta(days=30)
            self.start_edit.setText(to_jalali_str(start))
            self.end_edit.setText(to_jalali_str(last_date))
        self.refresh_current_page()

    def on_page_changed(self, idx):
        self.stack.setCurrentIndex(idx)
        self.refresh_current_page()

    def refresh_current_page(self):
        if not self.conn:
            return
        start = jalali_to_greg_str(self.start_edit.text())
        end = jalali_to_greg_str(self.end_edit.text())
        page = self.stack.currentWidget()
        if hasattr(page, "refresh"):
            page.refresh(self.conn, start, end)

    def refresh_all_pages(self):
        start = jalali_to_greg_str(self.start_edit.text())
        end = jalali_to_greg_str(self.end_edit.text())
        for p in [self.dashboard_page, self.comparison_page, self.market_maker_page, self.buyers_page,
                  self.sellers_page, self.brokers_page, self.behavior_page, self.anomalies_page, self.dq_page, self.new_shareholders_page]:
            p.refresh(self.conn, start, end)

    def _rebuild_derived_state(self):
        """پس از Import مستقل، فقط در صورت وجود هر دو دیتاست، هویت و FIFO را بازسازی می‌کند."""
        if not self.conn:
            return {"identity": None, "fifo": None}

        registry_count = self.conn.execute(
            "SELECT COUNT(*) FROM registry_holdings"
        ).fetchone()[0]

        transaction_count = self.conn.execute(
            "SELECT COUNT(*) FROM transactions"
        ).fetchone()[0]

        identity = None
        fifo = None

        if registry_count > 0:
            identity = reconcile_identities(self.conn)

        if registry_count > 0 and transaction_count > 0:
            fifo_result = pf.run_fifo(self.conn)
            fifo = fifo_result["summary"]

        return {
            "identity": identity,
            "fifo": fifo,
        }

